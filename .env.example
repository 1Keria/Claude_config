# 复制为 .env 并填入真实值（.env 不会提交到 Git）
# cp .env.example .env

# 第三方 API（Claude Code 登录用，bootstrap 注入到 settings.json）
# 讯飞 MaaS 格式：appid:secret
ANTHROPIC_AUTH_TOKEN=your-appid:your-secret

# MCP 常用密钥示例（按实际使用的 MCP 保留/删除）

# GitHub MCP
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxx

# Brave Search MCP
# BRAVE_API_KEY=xxxxxxxx

# 其他自定义 MCP
# MY_API_KEY=xxxxxxxx
